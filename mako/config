include=~/.config/mako/colors.matugen

output=eDP-1
layer=top
font=sans, 12
border-radius=16
icon-border-radius=8
padding=16
margin=8, 0
outer-margin=8
width=400
height=200
icons=1
border-size=0
text-alignment=right
default-timeout=10000
progress-color=over #00000000
format=<span font="11" font_weight="bold">%a</span>\n<span font="14">%s</span>\n%b
anchor=bottom-right
max-visible=5
on-button-middle=exec makoctl menu -n "$id" -- rofi -dmenu -theme-str 'window {height: 198;}' -e 'Select action: '

[mode=do-not-disturb]
invisible=1

[grouped=true]
format=(%g) <span font="14">%s</span>\n%b

[category=system]
default-timeout=2000
anchor=bottom-center
padding=16
border-radius=16
text-alignment=center
format=<span font="14">%s</span>\n%b
