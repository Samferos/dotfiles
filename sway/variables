# vim: filetype=swayconfig

set $mod Mod4

set $left Left
set $down Down
set $up Up
set $right Right

set $screen_locker swaylock
set $launch exec uwsm app --
set $term $launch foot
set $app_launcher ~/.config/scripts/sway/launch.sh
set $file_manager $launch nautilus
set $window_switcher rofi -show window
