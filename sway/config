# vim: filetype=swayconfig

include ./variables
include ./colors
include ./bindings

exec swayidle -w \
    timeout 300 'brillo -O; brillo -u 800000 -S 1' \
    resume 'brillo -I -u 800000' \
    timeout 320 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    timeout 330 'swaylock -f' \
    before-sleep 'swaylock -f'

# Autostart
exec batsignal
exec awww-daemon # Wallpaper Daemon

seat seat0 xcursor_theme Bibata-Modern-Ice 24

output eDP-1 {
    scale 1.0
    max_render_time off
    allow_tearing yes
    position 0 0
}

input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    drag_lock disabled
}

input type:keyboard {
    xkb_layout "fr,fr_plus,us"
    xkb_options "grp:sclk_toggle"
}

input type:pointer {
    accel_profile flat
    pointer_accel -0.5
}

default_border pixel 1
# smart_borders only shows focus borders when more that one window are displayed
smart_borders on
focus_wrapping no

for_window {
  [shell="xwayland"] title_format "%title [XWayland]"
  # Music player
  [app_id="com.github.neithern.g4music"] floating enable; \
                     resize set 412px 548px; \
                     move position 1504px 4px; \
                     mark music;
  # Bitwarden
  [title="^[Bb]itwarden$"] floating enable
  # Calculator
  [app_id="org.gnome.Calculator"] floating enable
}

bar {
    id 0
    position top
    modifier $mod+Ctrl
    swaybar_command waybar
}

include /etc/sway/config.d/*
exec uwsm finalize
