input {
    keyboard {
        xkb {
            layout "fr(oss),fr_plus"
            options "grp:win_space_toggle"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
        accel-speed -0.5
    }

    tablet {
        map-to-output "HDMI-A-1"
    }
}

cursor {
    xcursor-size 24
    xcursor-theme "Bibata-Modern-Ice"

    hide-when-typing
    // hide-after-inactive-ms 1000
}

gestures {
    hot-corners { off; }
}

output "eDP-1" {
    mode "1920x1080@60.008"

    scale 1
    transform "normal"
}

layout {
    gaps 8

    background-color "transparent"

    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        // off
        width 4
        active-color "#FCDFA6"
        inactive-color "#505050"
    }

    border { off; }

    shadow { }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

spawn-sh-at-startup "waybar --config ~/.config/waybar/config.niri.jsonc"
spawn-at-startup "awww-daemon"
//spawn-sh-at-startup "swaybg --image ~/Pictures/Backgrounds/ichika_falling.png"
spawn-at-startup "swayidle" "-w" \
"timeout" "300" "brillo -O; brillo -u 800000 -S 1" \
"resume" "brillo -I -u 800000" \
"timeout" "320" "niri msg action power-off-monitors" \
"timeout" "330" "swaylock -f" \
"before-sleep" "swaylock -f"

hotkey-overlay { skip-at-startup; }

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot_%d-%m-%Y_%H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
}

window-rule {
    // matches all windows
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="foot"
    default-column-width { proportion 0.5; }
}

window-rule {
    match is-floating=true

    shadow { on; }
}

layer-rule {
    match namespace="notifications"

    block-out-from "screencast"
}

layer-rule {
    match namespace="awww-daemon"
    match namespace="wallpaper"
    place-within-backdrop true
}

overview {
    zoom 0.4

    workspace-shadow {
        off
        softness 60
        spread 20
        color "#00000070"
    }
}

recent-windows {
    highlight {
        corner-radius 16
        padding 16
    }
}

binds {
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Ctrl+Left { consume-or-expel-window-left; }
    Mod+Ctrl+Right { consume-or-expel-window-right; }

    Mod+U              { focus-workspace-down; }
    Mod+Y              { focus-workspace-up; }

    Mod+A { switch-preset-column-width; }
    Mod+Shift+A { switch-preset-column-width-back; }

    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+X { expand-column-to-available-width; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Alt+Left { set-column-width "-5%"; }
    Mod+Alt+Right { set-column-width "+5%"; }
    Mod+Alt+Shift+Left { set-column-width "-20%"; }
    Mod+Alt+Shift+Right { set-column-width "+20%"; }

    Mod+Alt+Up { set-window-height "-5%"; }
    Mod+Alt+Down { set-window-height "+5%"; }
    Mod+Alt+Shift+Up { set-window-height "-20%"; }
    Mod+Alt+Shift+Down { set-window-height "+20%"; }

    Mod+Comma { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal" {
    spawn "foot"; }
    Mod+D hotkey-overlay-title="Run an Application: rofi" {
    spawn "rofi" "-show" "drun"; }
    Mod+E hotkey-overlay-title="Open File manager: nautilus" {
    spawn "nautilus"; }
    Super+L hotkey-overlay-title="Lock the Screen: swaylock" {spawn "swaylock"; }

    XF86AudioRaiseVolume allow-when-locked=true {
    spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true {
    spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true {
    spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true {
    spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-when-locked=true {
        spawn-sh "playerctl play-pause";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn-sh "playerctl previous";
    }
    XF86AudioNext allow-when-locked=true {
        spawn-sh "playerctl next";
    }

    XF86MonBrightnessUp allow-when-locked=true {
    spawn "brillo" "-A" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true {
    spawn "brillo" "-U" "10%-"; }

    Mod+Tab repeat=false { toggle-overview; }

    Mod+C repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Z { center-column; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }

    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+Alt+Page_Down { move-workspace-down; }
    Mod+Alt+Page_Up   { move-workspace-up; }

    Mod+Shift+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+WheelScrollDown      { focus-column-right; }
    Mod+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+ampersand { focus-workspace 1; }
    Mod+eacute { focus-workspace 2; }
    Mod+quotedbl { focus-workspace 3; }
    Mod+apostrophe { focus-workspace 4; }
    Mod+parenleft { focus-workspace 5; }
    Mod+minus { focus-workspace 6; }
    Mod+egrave { focus-workspace 7; }
    Mod+underscore { focus-workspace 8; }
    Mod+ccedilla { focus-workspace 9; }
    Mod+Shift+ampersand { move-column-to-workspace 1; }
    Mod+Shift+eacute { move-column-to-workspace 2; }
    Mod+Shift+quotedbl { move-column-to-workspace 3; }
    Mod+Shift+apostrophe { move-column-to-workspace 4; }
    Mod+Shift+parenleft { move-column-to-workspace 5; }
    Mod+Shift+minus { move-column-to-workspace 6; }
    Mod+Shift+egrave { move-column-to-workspace 7; }
    Mod+Shift+underscore { move-column-to-workspace 8; }
    Mod+Shift+ccedilla { move-column-to-workspace 9; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Alt+N { focus-monitor-next; }
    Mod+Alt+C { move-column-to-monitor-next; }

    Mod+Shift+S { toggle-window-floating; }
    Mod+S { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }

    Alt+Space { spawn "~/.config/scripts/nix-run.sh"; }

    Mod+T { spawn "~/.config/scripts/set_background.sh"; }
}
